# 监听端口
PORT=3000

# 后台账号：仅在首次启动（users 表为空）时写入数据库，之后以数据库为准
ADMIN_USERNAME=admin

# 留空 = 首次启动自动生成随机密码并打印到日志
ADMIN_PASSWORD=

# 至少 32 个字符；留空 = 自动生成并保存到 database/.jwt-secret
# 生成方式：openssl rand -hex 32
JWT_SECRET=

# 部署在 Nginx / Caddy 等反向代理后面时设为 1，否则拿不到真实客户端 IP
TRUST_PROXY=0

# 登录时间显示用的时区
APP_TIMEZONE=Asia/Shanghai
